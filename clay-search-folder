#!/usr/bin/env python3

import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time
from urllib.error import URLError
from urllib.parse import quote, urlencode, urlsplit
from urllib.request import HTTPRedirectHandler, ProxyHandler, build_opener


class LocalRedirect(HTTPRedirectHandler):
    def redirect_request(self, request, fp, code, message, headers, new_url):
        target = urlsplit(new_url)
        if target.scheme != "http" or target.hostname != "127.0.0.1" or target.username or target.password:
            raise URLError("HTML Clay redirected outside localhost")
        return super().redirect_request(request, fp, code, message, headers, new_url)


def document_url(document):
    home = Path.home().resolve()
    config_path = home / "Library/Application Support/htmlclay/config.json"
    config = json.loads(config_path.read_text())
    candidates = []
    for anchor, port in config.get("sitePorts", {}).items():
        if isinstance(port, int) and not isinstance(port, bool) and 0 < port < 65536 and document.is_relative_to(Path(anchor).resolve()):
            candidates.append((len(Path(anchor).parts), port))
    opener = build_opener(ProxyHandler({}), LocalRedirect())
    path = quote(document.relative_to(home).as_posix(), safe="/")
    for _, port in sorted(candidates):
        try:
            with opener.open(f"http://127.0.0.1:{port}/{path}", timeout=2) as response:
                url = response.geturl()
                html = response.read(2 << 20).decode("utf-8")
            token = re.search(r'<html\b[^>]*\bsavetoken=([\"\x27])(.*?)\1', html, re.IGNORECASE)
            if token is None:
                continue
            target = urlsplit(url)
            origin = f"{target.scheme}://{target.netloc}"
            with opener.open(origin + "/_/meta/" + quote(token.group(2), safe=""), timeout=2) as response:
                metadata = json.loads(response.read(2 << 20))
            info = metadata.get("document", {})
            helpers = info.get("helpers", [])
            if info.get("absolutePath") == str(document) and any(helper.get("name") == "search" and helper.get("state") == "ready" for helper in helpers):
                return url
        except (OSError, ValueError):
            continue
    return None


def launch(folder):
    root = Path(folder).expanduser().resolve(strict=True)
    if not root.is_dir() or not os.access(root, os.R_OK | os.X_OK):
        raise ValueError("Select a readable folder to search.")
    document = (Path(__file__).resolve().parent / "search.htmlclay").resolve(strict=True)
    if not document.is_file():
        raise ValueError(f"Search page not found: {document}")
    subprocess.run(["/usr/bin/open", "-g", "-a", "/Applications/HTMLClay.app"], check=True, capture_output=True, timeout=15)
    deadline = time.monotonic() + 30
    while time.monotonic() < deadline:
        try:
            url = document_url(document)
        except (OSError, ValueError):
            url = None
        if url:
            subprocess.run(["/usr/bin/open", url + "#" + urlencode({"root": str(root)})], check=True, capture_output=True, timeout=15)
            return
        time.sleep(0.2)
    raise TimeoutError("Search is not ready. Trust its folder in HTML Clay and allow the search helper, then try again.")


def main():
    parser = argparse.ArgumentParser(description="Open Search in one selected folder.")
    parser.add_argument("folder", help="Folder to search")
    args = parser.parse_args()
    try:
        launch(args.folder)
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
        print(f"Search with Clay: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
