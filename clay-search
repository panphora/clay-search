class SearchError(Exception):
    def __init__(self, code, message, details=None):
        super().__init__(message)
        self.code = code
        self.message = message
        self.details = details


class DuplicateKeyError(ValueError):
    pass


def object_without_duplicates(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise DuplicateKeyError(key)
        value[key] = item
    return value


def json_bytes(value):
    return json.dumps(value, ensure_ascii=False, separators=(",", ":")).encode("utf-8")


def emit(value):
    sys.stdout.buffer.write(json_bytes(value) + b"\n")
    sys.stdout.buffer.flush()


def emit_error(error):
    record = {"type": "error", "code": error.code, "message": error.message}
    if error.details is not None:
        record["details"] = error.details
    emit(record)


def read_request():
    raw = sys.stdin.buffer.read(INPUT_BYTES + 1)
    if len(raw) > INPUT_BYTES:
        raise SearchError("invalid_request", "Request is too large", {"limit": INPUT_BYTES})
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        raise SearchError("invalid_request", "Request is not valid UTF-8") from None
    try:
        request = json.loads(text, object_pairs_hook=object_without_duplicates)
    except DuplicateKeyError as error:
        raise SearchError("invalid_request", "Request contains a duplicate key", {"field": str(error)}) from None
    except json.JSONDecodeError:
        raise SearchError("invalid_request", "Request is not valid JSON") from None
    if not isinstance(request, dict):
        raise SearchError("invalid_request", "Request must be a JSON object")
    return request


def descriptor():
    return {
        "helperProtocol": HELPER_PROTOCOL,
        "contract": CONTRACT,
        "operations": ["search", "scopes", "chooseFolder", "reveal"],
        "search": {
            "required": ["op", "query"],
            "optional": ["scope", "root", "mode", "fileType", "fileKind"],
            "scopes": [s["key"] for s in available_scopes()],
            "defaultScope": DEFAULT_SCOPE,
            "modes": ["name", "contents"],
            "fileKinds": FILE_KINDS,
            "match": {
                "path": "scope-relative path",
                "line": "one-based line number for contents matches",
                "text": "bounded line text for contents matches",
                "textTruncated": "whether bounded line text was shortened",
            },
        },
        "limits": {
            "resultBytes": RESULT_BYTES,
            "matchTextBytes": MATCH_TEXT_BYTES,
            "queryBytes": QUERY_BYTES,
            "deadlineMs": TOOL_TIMEOUT_SECONDS * 1000,
        },
    }


def require_string(payload, field, maximum, allow_empty=False):
    value = payload.get(field)
    if not isinstance(value, str) or (not allow_empty and not value):
        raise SearchError("invalid_request", f"{field} must be a nonempty string", {"field": field})
    if "\0" in value:
        raise SearchError("invalid_request", f"{field} contains a null byte", {"field": field})
    if len(value.encode("utf-8")) > maximum:
        raise SearchError("invalid_request", f"{field} is too large", {"field": field, "limit": maximum})
    return value


def request_payload(request):
    protocol = request.get("helperProtocol")
    if protocol is not None and protocol != HELPER_PROTOCOL:
        raise SearchError("unsupported_protocol", "Unsupported helper protocol", {"helperProtocol": protocol})
    if request.get("type") != "wire/request" or not isinstance(request.get("payload"), dict):
        raise SearchError("invalid_request", "Expected a wire request with an object payload")
    return request["payload"]


def resolve_root(value):
    value = require_string({"root": value}, "root", TOOL_PATH_BYTES)
    path = Path(value).expanduser()
    if not path.is_absolute():
        raise SearchError("invalid_request", "Use an absolute folder path or a ~/ path", {"field": "root"})
    try:
        root = path.resolve(strict=True)
    except (OSError, RuntimeError):
        raise SearchError("scope_unavailable", "That folder does not exist", {"root": value}) from None
    if not root.is_dir() or not os.access(root, os.R_OK | os.X_OK):
        raise SearchError("scope_unavailable", "That path is not a readable folder", {"root": value})
    return root


def selected_root(payload):
    if "root" in payload:
        if "scope" in payload:
            raise SearchError("invalid_request", "Choose either root or scope")
        return None, resolve_root(payload["root"])
    scope_key = payload.get("scope", DEFAULT_SCOPE)
    if not isinstance(scope_key, str):
        raise SearchError("invalid_request", "scope must be a string", {"field": "scope"})
    return scope_key, resolve_scope(scope_key)


def file_extensions(payload):
    kind = payload.get("fileKind")
    extension = payload.get("fileType")
    if kind not in (None, "", "all"):
        if not isinstance(kind, str) or kind not in FILE_KINDS:
            raise SearchError("invalid_request", "Unknown file category", {"field": "fileKind"})
        if extension not in (None, ""):
            raise SearchError("invalid_request", "Choose a category or a custom extension")
        return FILE_KINDS[kind]
    if extension in (None, ""):
        return ()
    if not isinstance(extension, str):
        raise SearchError("invalid_request", "fileType must be a string", {"field": "fileType"})
    extension = extension.removeprefix(".")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+-]{0,63}", extension):
        raise SearchError("invalid_request", "fileType is not a valid extension", {"field": "fileType"})
    return (extension.lower(),)


MACOS = sys.platform == "darwin"
FILE_MANAGER = "Finder" if MACOS else "Files"
TOOL_ALIASES = {"fd": ("fdfind",)}


def is_cloud_root(root):
    cloud_roots = [Path.home() / "Library/CloudStorage", Path.home() / "Library/Mobile Documents", Path.home() / "Dropbox"]
    for path in cloud_roots:
        try:
            cloud = path.resolve(strict=True)
        except (OSError, RuntimeError):
            continue
        if root == cloud or cloud in root.parents or root in cloud.parents:
            return True
    return False


def choose_folder():
    if MACOS:
        return choose_folder_macos()
    pickers = (
        ["zenity", "--file-selection", "--directory", "--title=Choose a folder to search"],
        ["kdialog", "--getexistingdirectory", str(Path.home()), "--title", "Choose a folder to search"],
    )
    for command in pickers:
        if shutil.which(command[0]) is None:
            continue
        try:
            result = subprocess.run(command, capture_output=True, text=True, timeout=120)
        except (OSError, subprocess.TimeoutExpired):
            raise SearchError("folder_picker_failed", "The folder picker could not complete") from None
        chosen = result.stdout.rstrip("\n")
        if result.returncode == 1 and not chosen:
            return {"cancelled": True}
        if result.returncode or not chosen:
            raise SearchError("folder_picker_failed", "The folder picker could not open")
        return {"root": str(resolve_root(chosen)), "cancelled": False}
    raise SearchError("folder_picker_failed", "Install zenity or kdialog to choose a folder, or type the path")


def choose_folder_macos():
    script = 'activate me\nPOSIX path of (choose folder with prompt "Choose a folder to search")'
    try:
        result = subprocess.run(["/usr/bin/osascript", "-e", script], capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        raise SearchError("folder_picker_failed", "The folder picker could not complete") from None
    if result.returncode:
        if "(-128)" in result.stderr:
            return {"cancelled": True}
        raise SearchError("folder_picker_failed", "The folder picker could not open")
    return {"root": str(resolve_root(result.stdout.rstrip("\n"))), "cancelled": False}


def reveal_file(payload):
    _, root = selected_root(payload)
    path = require_string(payload, "path", TOOL_PATH_BYTES)
    if Path(path).is_absolute():
        raise SearchError("invalid_request", "The result path must be relative to its search folder")
    confined = confined_path(root, path)
    if confined is None:
        raise SearchError("file_unavailable", "That file no longer exists")
    resolved, _ = confined
    try:
        show_in_file_manager(resolved)
    except (OSError, subprocess.SubprocessError):
        raise SearchError("reveal_failed", f"{FILE_MANAGER} could not show that file") from None
    return {"revealed": True}


def show_in_file_manager(path):
    if MACOS:
        subprocess.run(["/usr/bin/open", "-R", str(path)], check=True, capture_output=True, timeout=10)
        return
    if shutil.which("gdbus"):
        result = subprocess.run(
            ["gdbus", "call", "--session", "--dest", "org.freedesktop.FileManager1",
             "--object-path", "/org/freedesktop/FileManager1",
             "--method", "org.freedesktop.FileManager1.ShowItems", f"['{path.as_uri()}']", ""],
            capture_output=True, timeout=10,
        )
        if result.returncode == 0:
            return
    subprocess.run(["xdg-open", str(path.parent)], check=True, capture_output=True, timeout=10)


def parse_search_request(request):
    payload = request_payload(request)
    if payload.get("op") != "search":
        raise SearchError("unsupported_operation", "Unsupported operation", {"op": payload.get("op")})
    mode = payload.get("mode", "contents")
    if mode not in ("name", "contents"):
        raise SearchError("invalid_request", "mode must be name or contents", {"field": "mode"})
    query = require_string(payload, "query", QUERY_BYTES, allow_empty=mode == "name")
    extensions = file_extensions(payload)
    scope_key, root = selected_root(payload)
    return scope_key, root, scope_excludes(root), query, mode, extensions


SCOPES = (
    ("home", "Home", ""),
    ("documents", "Documents", "Documents"),
    ("desktop", "Desktop", "Desktop"),
    ("downloads", "Downloads", "Downloads"),
    ("dropbox", "Dropbox", "Library/CloudStorage/Dropbox" if sys.platform == "darwin" else "Dropbox"),
)
DEFAULT_SCOPE = "documents"

# Folders a sync client fills on demand. Reading a placeholder makes it download
# the file, so a contents search over one of these pulls the whole folder down
# and times out. Filename search never opens a file and is unaffected.
CLOUD_SCOPES = ("dropbox",)
SF_DATALESS = 0x40000000
LOCAL_LIST_BYTES = 800 << 10
LOCAL_LIST_COUNT = 20000

# Folders under a scope that every search skips, relative to the home folder.
# Selecting one directly as the folder still searches it.
EXCLUDED = ()


def scope_table():
    return {key: (label, relative) for key, label, relative in SCOPES}


def resolve_scope(key):
    """Resolve an existing named shortcut to a folder on disk."""
    entry = scope_table().get(key)
    if entry is None:
        raise SearchError("unknown_scope", "Unknown search scope", {"scope": key, "known": [k for k, _, _ in SCOPES]})
    label, relative = entry
    try:
        root = (Path.home() / relative).resolve(strict=True)
    except (OSError, RuntimeError):
        raise SearchError("scope_unavailable", f"{label} is not on this machine", {"scope": key}) from None
    if not root.is_dir():
        raise SearchError("scope_unavailable", f"{label} is not a folder", {"scope": key})
    return root


def scope_excludes(root):
    """Paths to skip, relative to the scope root, for the tools to glob out.

    Strict containment, so selecting an excluded folder as its own scope still
    searches it instead of excluding everything.
    """
    out = []
    for relative in EXCLUDED:
        try:
            path = (Path.home() / relative).resolve(strict=True)
        except (OSError, RuntimeError):
            continue
        if root in path.parents:
            out.append(str(path.relative_to(root)))
    return out


def available_scopes():
    out = []
    for key, label, relative in SCOPES:
        path = Path.home() / relative
        out.append({
            "key": key,
            "label": label,
            "available": path.is_dir(),
            "path": str(path.resolve()),
            "cloud": key in CLOUD_SCOPES,
        })
    return out


def local_files(root, excludes=()):
    """Enumerate searchable paths before filtering out cloud placeholders."""
    class DownloadedFiles:
        def __init__(self):
            self.paths = []
            self.skipped = 0
            self.used = 0

        def add(self, hit):
            path = str(root / hit["path"])
            try:
                info = os.lstat(path)
            except OSError:
                return True
            if not stat.S_ISREG(info.st_mode):
                return True
            if getattr(info, "st_flags", 0) & SF_DATALESS:
                self.skipped += 1
                return True
            size = len(os.fsencode(path)) + 1
            if len(self.paths) >= LOCAL_LIST_COUNT or self.used + size > LOCAL_LIST_BYTES:
                self.skipped += 1
                return True
            self.paths.append(path)
            self.used += size
            return True

    files = DownloadedFiles()
    arguments = [find_tool("rg"), "--files", "--null"]
    for skip in excludes:
        arguments.extend(("--glob", f"!**/{skip}/**"))
    arguments.extend(("--", str(root)))
    parser = NameParser(root, files)
    return_code, diagnostics, _ = run_tool(arguments, parser, time.monotonic() + TOOL_TIMEOUT_SECONDS)
    if return_code not in (0, 1):
        raise SearchError("search_failed", "File enumeration failed", {"status": return_code, "stderr": diagnostics})
    return files.paths, files.skipped


def find_tool(name):
    for candidate in (name, *TOOL_ALIASES.get(name, ())):
        path = shutil.which(candidate)
        if path is not None:
            return str(Path(path).resolve())
    raise SearchError("tool_unavailable", f"{name} is not installed", {"tool": name})


def decoded_rg_value(value):
    if not isinstance(value, dict):
        raise SearchError("search_failed", "Search tool returned an invalid value")
    text = value.get("text")
    if isinstance(text, str):
        return text.encode("utf-8")
    encoded = value.get("bytes")
    if isinstance(encoded, str):
        try:
            return base64.b64decode(encoded, validate=True)
        except ValueError:
            pass
    raise SearchError("search_failed", "Search tool returned invalid text")


def decoded_rg_path(value):
    raw = decoded_rg_value(value)
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        raise SearchError("search_failed", "Search tool returned a non-UTF-8 path") from None


def confined_path(root, raw_path):
    candidate = Path(raw_path)
    if not candidate.is_absolute():
        candidate = root / candidate
    try:
        resolved = candidate.resolve(strict=True)
    except (OSError, RuntimeError):
        return None
    try:
        relative = resolved.relative_to(root)
    except ValueError:
        raise SearchError(
            "path_outside_root",
            "Search tool returned a path outside the search folder",
            {"root": str(root), "path": raw_path},
        ) from None
    if not resolved.is_file():
        return None
    return resolved, relative.as_posix()


def bounded_text(raw):
    if raw.endswith(b"\n"):
        raw = raw[:-1]
    if raw.endswith(b"\r"):
        raw = raw[:-1]
    text = raw.decode("utf-8", errors="replace")
    encoded = text.encode("utf-8")
    truncated = len(encoded) > MATCH_TEXT_BYTES
    if truncated:
        text = encoded[:MATCH_TEXT_BYTES].decode("utf-8", errors="ignore")
    return text, truncated


def read_line_from_file(path, line_number, deadline):
    current = 1
    line = bytearray()
    truncated = False
    try:
        with path.open("rb") as source:
            while True:
                if time.monotonic() >= deadline:
                    raise SearchError("search_timeout", "Search timed out")
                chunk = source.read(64 << 10)
                if not chunk:
                    break
                start = 0
                while start < len(chunk):
                    newline = chunk.find(b"\n", start)
                    end = len(chunk) if newline < 0 else newline + 1
                    if current == line_number:
                        available = MATCH_TEXT_BYTES + 2 - len(line)
                        if available > 0:
                            line.extend(chunk[start:end][:available])
                        if end - start > available:
                            truncated = True
                    if newline < 0:
                        break
                    if current == line_number:
                        text, capped = bounded_text(bytes(line))
                        return text, truncated or capped
                    current += 1
                    start = end
            if current == line_number:
                text, capped = bounded_text(bytes(line))
                return text, truncated or capped
    except OSError:
        return "", True
    return "", True


class ResultBuilder:
    def __init__(self, root):
        self.hits = []
        self.prefix = b'{"type":"result","value":{"root":' + json_bytes(str(root)) + b',"matches":['
        self.size = len(self.prefix) + len(RESULT_SUFFIX_COMPLETE)
        self.truncated = False

    def add(self, hit):
        encoded = json_bytes(hit)
        addition = len(encoded) + (1 if self.hits else 0)
        if self.size + addition > RESULT_BYTES:
            self.truncated = True
            return False
        self.hits.append(encoded)
        self.size += addition
        return True

    def record(self):
        suffix = RESULT_SUFFIX_TRUNCATED if self.truncated else RESULT_SUFFIX_COMPLETE
        record = self.prefix + b",".join(self.hits) + suffix
        if len(record) > RESULT_BYTES:
            raise RuntimeError("result record exceeded its byte limit")
        return record


class NameParser:
    def __init__(self, root, results):
        self.root = root
        self.results = results
        self.pending = bytearray()
        self.stopped = False

    def feed(self, chunk):
        if self.stopped:
            return
        self.pending.extend(chunk)
        if len(self.pending) > TOOL_PATH_BYTES and b"\0" not in self.pending:
            raise SearchError("search_failed", "Search tool returned an oversized path")
        while True:
            boundary = self.pending.find(0)
            if boundary < 0:
                return
            raw = bytes(self.pending[:boundary])
            del self.pending[: boundary + 1]
            try:
                path_text = raw.decode("utf-8")
            except UnicodeDecodeError:
                continue
            confined = confined_path(self.root, path_text)
            if confined is None:
                continue
            _, relative = confined
            if not self.results.add({"path": relative}):
                self.stopped = True
                return

    def finish(self):
        if self.pending:
            raise SearchError("search_failed", "Search tool returned an unterminated path")


class RgLine:
    TEXT_MARKER = b'"lines":{"text":"'
    BYTES_MARKER = b'"lines":{"bytes":"'

    def __init__(self):
        self.total = 0
        self.head = bytearray()
        self.marker_kind = None
        self.scanned = 0
        self.escaped = False
        self.lines_ended = False
        self.after_lines = bytearray()

    def feed(self, data):
        prior_total = self.total
        self.total += len(data)
        remaining = TOOL_RECORD_HEAD_BYTES - len(self.head)
        if remaining > 0:
            self.head.extend(data[:remaining])
        if self.marker_kind is None:
            positions = []
            for kind, marker in (("text", self.TEXT_MARKER), ("bytes", self.BYTES_MARKER)):
                position = self.head.find(marker)
                if position >= 0:
                    positions.append((position, kind, marker))
            if positions:
                position, self.marker_kind, marker = min(positions)
                marker_end = position + len(marker)
                self._scan(bytes(self.head[marker_end:]))
                self.scanned = len(self.head)
        if self.marker_kind is not None and self.scanned < self.total:
            offset = max(self.scanned, prior_total) - prior_total
            self._scan(data[offset:])
            self.scanned = self.total

    def _scan(self, data):
        if self.lines_ended:
            remaining = TOOL_RECORD_AFTER_LINES_BYTES - len(self.after_lines)
            if remaining > 0:
                self.after_lines.extend(data[:remaining])
            return
        for index, byte in enumerate(data):
            if self.escaped:
                self.escaped = False
            elif byte == 92:
                self.escaped = True
            elif byte == 34:
                self.lines_ended = True
                remaining = TOOL_RECORD_AFTER_LINES_BYTES - len(self.after_lines)
                if remaining > 0:
                    self.after_lines.extend(data[index + 1 : index + 1 + remaining])
                return


class ContentsParser:
    def __init__(self, root, results, deadline):
        self.root = root
        self.results = results
        self.deadline = deadline
        self.line = RgLine()
        self.stopped = False

    def feed(self, chunk):
        if self.stopped:
            return
        start = 0
        while start < len(chunk):
            boundary = chunk.find(b"\n", start)
            if boundary < 0:
                self.line.feed(chunk[start:])
                return
            self.line.feed(chunk[start:boundary])
            self._finish_line()
            if self.stopped:
                return
            self.line = RgLine()
            start = boundary + 1

    def finish(self):
        if self.line.total:
            self._finish_line()

    def _finish_line(self):
        if self.line.total == 0:
            raise SearchError("search_failed", "Search tool returned a blank record")
        if self.line.total <= TOOL_RECORD_HEAD_BYTES:
            try:
                record = json.loads(bytes(self.line.head).decode("utf-8"))
            except (UnicodeDecodeError, json.JSONDecodeError):
                raise SearchError("search_failed", "Search tool returned invalid JSON") from None
            self._handle_record(record)
            return
        self._handle_oversized_match()

    def _handle_record(self, record):
        if not isinstance(record, dict):
            raise SearchError("search_failed", "Search tool returned a non-object record")
        record_type = record.get("type")
        if record_type in ("begin", "end", "summary"):
            return
        if record_type != "match":
            raise SearchError("search_failed", "Search tool returned an unknown record type")
        data = record.get("data")
        if not isinstance(data, dict):
            raise SearchError("search_failed", "Search tool returned invalid match data")
        path_text = decoded_rg_path(data.get("path"))
        line_number = data.get("line_number")
        if not isinstance(line_number, int) or isinstance(line_number, bool) or line_number < 1:
            raise SearchError("search_failed", "Search tool returned an invalid line number")
        confined = confined_path(self.root, path_text)
        if confined is None:
            return
        _, relative = confined
        raw_text = decoded_rg_value(data.get("lines"))
        text, text_truncated = bounded_text(raw_text)
        self._add(relative, line_number, text, text_truncated)

    def _handle_oversized_match(self):
        head = bytes(self.line.head)
        if b'"type":"match"' not in head or self.line.marker_kind is None or not self.line.lines_ended:
            raise SearchError("search_failed", "Search tool returned an oversized invalid record")
        path_start = head.find(b'"path":')
        lines_start = head.find(b',"lines":', path_start)
        if path_start < 0 or lines_start < 0:
            raise SearchError("search_failed", "Search tool returned an oversized invalid match")
        try:
            path_value = json.loads(head[path_start + len(b'"path":') : lines_start].decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError):
            raise SearchError("search_failed", "Search tool returned an invalid path") from None
        match = re.search(rb'\},"line_number":([0-9]+|null),', bytes(self.line.after_lines))
        if match is None or match.group(1) == b"null":
            raise SearchError("search_failed", "Search tool returned an invalid line number")
        path_text = decoded_rg_path(path_value)
        line_number = int(match.group(1))
        confined = confined_path(self.root, path_text)
        if confined is None:
            return
        resolved, relative = confined
        text, _ = read_line_from_file(resolved, line_number, self.deadline)
        self._add(relative, line_number, text, True)

    def _add(self, relative, line_number, text, text_truncated):
        hit = {"path": relative, "line": line_number, "text": text}
        if text_truncated:
            hit["textTruncated"] = True
        if not self.results.add(hit):
            self.stopped = True


def stop_process(process):
    if process.poll() is None:
        process.terminate()
        try:
            process.wait(timeout=0.5)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()
    if process.stdout is not None:
        process.stdout.close()
    if process.stderr is not None:
        process.stderr.close()


def run_tool(arguments, parser, deadline):
    try:
        process = subprocess.Popen(arguments, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except OSError as error:
        raise SearchError("tool_unavailable", "Search tool could not start", {"error": str(error)}) from None
    selector = selectors.DefaultSelector()
    selector.register(process.stdout, selectors.EVENT_READ, "stdout")
    selector.register(process.stderr, selectors.EVENT_READ, "stderr")
    diagnostics = bytearray()
    stopped = False
    try:
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise SearchError("search_timeout", "Search timed out")
            events = selector.select(min(remaining, 0.25))
            if not events:
                continue
            for key, _ in events:
                chunk = os.read(key.fileobj.fileno(), 64 << 10)
                if not chunk:
                    selector.unregister(key.fileobj)
                    if key.data == "stdout":
                        parser.finish()
                    continue
                if key.data == "stdout":
                    parser.feed(chunk)
                    if parser.stopped:
                        stopped = True
                        break
                else:
                    remaining_error = TOOL_ERROR_BYTES - len(diagnostics)
                    if remaining_error > 0:
                        diagnostics.extend(chunk[:remaining_error])
            if stopped:
                break
        if stopped:
            stop_process(process)
            return 0, "", True
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise SearchError("search_timeout", "Search timed out")
        return_code = process.wait(timeout=remaining)
        return return_code, diagnostics.decode("utf-8", errors="replace").strip(), False
    except subprocess.TimeoutExpired:
        raise SearchError("search_timeout", "Search timed out") from None
    finally:
        selector.close()
        stop_process(process)


def search(root, excludes, targets, query, mode, extensions):
    results = ResultBuilder(root)
    deadline = time.monotonic() + TOOL_TIMEOUT_SECONDS
    if mode == "name":
        arguments = [find_tool("fd"), "--type", "file", "--absolute-path", "--print0", "--fixed-strings"]
        for skip in excludes:
            arguments.extend(("--exclude", f"**/{skip}/**"))
        for extension in extensions:
            arguments.extend(("--extension", extension))
        arguments.extend(("--", query, *targets))
        parser = NameParser(root, results)
        return_code, diagnostics, stopped = run_tool(arguments, parser, deadline)
        if not stopped and return_code != 0:
            raise SearchError("search_failed", "Filename search failed", {"status": return_code, "stderr": diagnostics})
    else:
        arguments = [find_tool("rg"), "--json", "--line-number", "--fixed-strings"]
        for extension in extensions:
            suffix = "".join(f"[{letter.lower()}{letter.upper()}]" if letter.isalpha() else letter for letter in extension)
            arguments.extend(("--glob", f"*.{suffix}"))
        for skip in excludes:
            # The leading **/ is load-bearing: the search root is absolute, and
            # a root-relative glob matches nothing against an absolute path.
            arguments.extend(("--glob", f"!**/{skip}/**"))
        arguments.extend(("--", query, *targets))
        parser = ContentsParser(root, results, deadline)
        return_code, diagnostics, stopped = run_tool(arguments, parser, deadline)
        if not stopped and return_code not in (0, 1):
            raise SearchError("search_failed", "Contents search failed", {"status": return_code, "stderr": diagnostics})
    return results.record()


def main():
    try:
        request = read_request()
        if request.get("type") == "wire/describe":
            emit({"type": "result", "value": descriptor()})
            return 0
        payload = request_payload(request)
        if payload.get("op") == "scopes":
            result = {"scopes": available_scopes(), "default": DEFAULT_SCOPE, "defaultRoot": str(Path.home() / "Documents"), "fileManager": FILE_MANAGER}
            emit({"type": "result", "value": result})
            return 0
        if payload.get("op") == "chooseFolder":
            emit({"type": "result", "value": choose_folder()})
            return 0
        if payload.get("op") == "reveal":
            emit({"type": "result", "value": reveal_file(payload)})
            return 0
        scope_key, root, excludes, query, mode, extensions = parse_search_request(request)
        targets = [str(root)]
        status = "Scanning names" if mode == "name" else "Scanning contents"
        if mode == "contents" and (scope_key in CLOUD_SCOPES or is_cloud_root(root)):
            targets, skipped = local_files(root, excludes)
            suffixes = tuple(f".{extension.lower()}" for extension in extensions)
            excluded_roots = [root / relative for relative in excludes]
            targets = [
                path for path in targets
                if (not suffixes or path.lower().endswith(suffixes))
                and not any(Path(path).is_relative_to(excluded) for excluded in excluded_roots)
            ]
            if not targets:
                emit({"type": "result", "value": {"root": str(root), "matches": [], "truncated": False, "skippedNotDownloaded": skipped}})
                return 0
            if skipped:
                status = f"Searching {len(targets)} downloaded files, skipping {skipped} not on this computer"
        emit({"type": "status", "text": status})
        record = search(root, excludes, targets, query, mode, extensions)
        sys.stdout.buffer.write(record + b"\n")
        sys.stdout.buffer.flush()
        return 0
    except SearchError as error:
        emit_error(error)
        return 0
    except BrokenPipeError:
        return 1
    except Exception as error:
        print(f"clay-search: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
