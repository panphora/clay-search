HELPER_PROTOCOL = 1
CONTRACT = "clay-search/1"
INPUT_BYTES = 1 << 20
RESULT_BYTES = 512 << 10
MATCH_TEXT_BYTES = 4 << 10
QUERY_BYTES = 4 << 10
TOOL_RECORD_HEAD_BYTES = 16 << 10
TOOL_RECORD_AFTER_LINES_BYTES = 32 << 10
TOOL_PATH_BYTES = 64 << 10
TOOL_ERROR_BYTES = 8 << 10
TOOL_TIMEOUT_SECONDS = 285

RESULT_SUFFIX_COMPLETE = b'],"truncated":false}}'
RESULT_SUFFIX_TRUNCATED = b'],"truncated":true}}'

