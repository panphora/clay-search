<!DOCTYPE html><html viewonly documentid="d3da2ee5-b2ed-436d-8102-431850cd6e8e" lang="en"><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="htmlclay-helper" content="search">
  <title>Search</title>
  <style>
    :root {
      color-scheme: light;
      --canvas: #f3f1ec;
      --canvas-raised: #f8f7f3;
      --surface: #ebe9e3;
      --surface-hover: #e5e8ee;
      --surface-active: #dfe5f2;
      --text: #23262d;
      --text-soft: #686b72;
      --text-faint: #92949a;
      --line: #d8d5ce;
      --line-strong: #c5c2ba;
      --accent: #4869c8;
      --accent-soft: #dde5fb;
      --accent-ink: #294baf;
      --mark: #f2d675;
      --mark-ink: #302a18;
      --danger: #a24b45;
      --danger-soft: #f3e3df;
      --warning: #8a6925;
      --warning-soft: #f1e9cf;
      --shadow: 0 1px 2px rgba(35, 38, 45, 0.05), 0 12px 40px rgba(35, 38, 45, 0.06);
      --focus: 0 0 0 3px rgba(72, 105, 200, 0.2);
    }

    @media (prefers-color-scheme: dark) {
      :root {
        color-scheme: dark;
        --canvas: #1b1c1f;
        --canvas-raised: #222428;
        --surface: #292b30;
        --surface-hover: #30343b;
        --surface-active: #30394a;
        --text: #e8e7e2;
        --text-soft: #aaa9a5;
        --text-faint: #797b81;
        --line: #35373d;
        --line-strong: #494c53;
        --accent: #8aa5f5;
        --accent-soft: #283653;
        --accent-ink: #acc0fb;
        --mark: #725e25;
        --mark-ink: #f3e6b2;
        --danger: #e3968f;
        --danger-soft: #452b2b;
        --warning: #d1ad5d;
        --warning-soft: #3e3624;
        --shadow: 0 1px 2px rgba(8, 9, 11, 0.18), 0 16px 48px rgba(8, 9, 11, 0.2);
        --focus: 0 0 0 3px rgba(138, 165, 245, 0.22);
      }
    }

    * {
      box-sizing: border-box;
    }

    html {
      min-height: 100%;
      background: var(--canvas);
    }

    body {
      min-width: 320px;
      min-height: 100vh;
      margin: 0;
      background: var(--canvas);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", sans-serif;
      font-size: 14px;
      -webkit-font-smoothing: antialiased;
    }

    button,
    input {
      color: inherit;
      font: inherit;
    }

    button,
    label {
      -webkit-tap-highlight-color: transparent;
    }

    .app {
      width: min(1040px, calc(100% - 40px));
      margin: 0 auto;
      padding: 24px 0 72px;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 28px;
      color: var(--text-soft);
    }

    .identity {
      display: flex;
      align-items: center;
      gap: 9px;
      font-size: 12px;
      font-weight: 650;
      letter-spacing: 0.02em;
    }

    .identity-mark {
      position: relative;
      width: 18px;
      height: 18px;
      border: 1px solid var(--line-strong);
      border-radius: 6px;
      background: var(--canvas-raised);
    }

    .identity-mark::before {
      position: absolute;
      top: 4px;
      left: 4px;
      width: 6px;
      height: 6px;
      border: 1.5px solid var(--accent);
      border-radius: 50%;
      content: "";
    }

    .identity-mark::after {
      position: absolute;
      top: 10px;
      left: 10px;
      width: 4px;
      height: 1.5px;
      border-radius: 1px;
      background: var(--accent);
      content: "";
      transform: rotate(45deg);
      transform-origin: left center;
    }

    .access {
      display: flex;
      align-items: center;
      gap: 7px;
      min-width: 0;
      font-size: 12px;
    }

    .access-dot {
      width: 6px;
      height: 6px;
      flex: 0 0 auto;
      border-radius: 50%;
      background: var(--text-faint);
    }

    .access[data-state="ready"] .access-dot {
      background: var(--accent);
    }

    .access[data-state="denied"] .access-dot,
    .access[data-state="error"] .access-dot {
      background: var(--danger);
    }

    .access[data-state="unavailable"] .access-dot {
      background: var(--warning);
    }

    .command-wrap {
      width: min(780px, 100%);
      margin: clamp(110px, 23vh, 220px) auto 0;
      transition: width 220ms ease, margin 260ms ease;
    }

    body.has-query .command-wrap {
      width: 100%;
      margin-top: 26px;
    }

    .command {
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: var(--canvas-raised);
      box-shadow: var(--shadow);
      transition: border-radius 220ms ease;
    }

    .command:focus-within {
      border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
      box-shadow: var(--shadow), var(--focus);
    }

    body.has-query .command {
      border-radius: 13px;
    }

    .query-row {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 14px;
      min-height: 74px;
      padding: 0 20px;
      transition: min-height 220ms ease;
    }

    body.has-query .query-row {
      min-height: 62px;
    }

    .search-icon {
      position: relative;
      width: 21px;
      height: 21px;
      color: var(--text-faint);
    }

    .search-icon::before {
      position: absolute;
      top: 2px;
      left: 2px;
      width: 10px;
      height: 10px;
      border: 1.75px solid currentColor;
      border-radius: 50%;
      content: "";
    }

    .search-icon::after {
      position: absolute;
      top: 13px;
      left: 13px;
      width: 7px;
      height: 1.75px;
      border-radius: 1px;
      background: currentColor;
      content: "";
      transform: rotate(45deg);
      transform-origin: left center;
    }

    #query {
      width: 100%;
      min-width: 0;
      padding: 10px 0;
      border: 0;
      outline: 0;
      background: transparent;
      caret-color: var(--accent);
      font-size: clamp(23px, 3.2vw, 31px);
      font-weight: 430;
      letter-spacing: -0.025em;
      line-height: 1.2;
      transition: font-size 220ms ease;
    }

    body.has-query #query {
      font-size: 21px;
      letter-spacing: -0.015em;
    }

    #query::placeholder {
      color: var(--text-faint);
      opacity: 1;
    }

    #query:disabled {
      cursor: not-allowed;
      opacity: 0.55;
    }

    .shortcut {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 38px;
      height: 24px;
      padding: 0 7px;
      border: 1px solid var(--line);
      border-bottom-color: var(--line-strong);
      border-radius: 6px;
      background: var(--surface);
      color: var(--text-faint);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.01em;
    }

    .filters {
      display: grid;
      grid-template-columns: auto minmax(130px, 0.7fr) minmax(180px, 1fr);
      gap: 12px;
      padding: 12px;
      border-top: 1px solid var(--line);
      background: color-mix(in srgb, var(--surface) 45%, var(--canvas-raised));
    }

    .mode-switch {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-self: end;
      padding: 3px;
      border: 1px solid var(--line);
      border-radius: 9px;
      background: var(--canvas);
    }

    .mode-option {
      position: relative;
      cursor: pointer;
    }

    .mode-option input {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
      pointer-events: none;
    }

    .mode-option span {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 30px;
      padding: 0 12px;
      border-radius: 6px;
      color: var(--text-soft);
      font-size: 12px;
      font-weight: 600;
      white-space: nowrap;
    }

    .mode-option input:checked + span {
      background: var(--canvas-raised);
      box-shadow: 0 1px 3px rgba(35, 38, 45, 0.1);
      color: var(--text);
    }

    .mode-option input:focus-visible + span {
      box-shadow: var(--focus);
    }

    .mode-option input:disabled + span {
      cursor: not-allowed;
      opacity: 0.5;
    }

    .field {
      display: grid;
      gap: 5px;
      min-width: 0;
    }

    .field-label {
      padding-left: 2px;
      color: var(--text-faint);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.08em;
      line-height: 1;
      text-transform: uppercase;
    }

    .field input,
    .field select {
      width: 100%;
      height: 34px;
      padding: 0 10px;
      border: 1px solid var(--line);
      border-radius: 8px;
      outline: 0;
      background: var(--canvas-raised);
      color: var(--text);
      font-size: 12px;
    }

    .field input::placeholder {
      color: var(--text-faint);
    }

    .field input:focus,
    .field select:focus {
      border-color: var(--accent);
      box-shadow: var(--focus);
    }

    .field input:disabled,
    .field select:disabled {
      cursor: not-allowed;
      opacity: 0.5;
    }

    .folder-field { grid-column: 1 / -1; }
    .folder-controls { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; }
    .folder-controls button {
      padding: 0 12px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--canvas-raised);
      color: var(--text);
      font: inherit;
      font-size: 12px;
      cursor: pointer;
    }
    .folder-controls button:focus-visible { outline: 0; box-shadow: var(--focus); }
    .folder-controls button:disabled { cursor: not-allowed; opacity: 0.5; }
    #fileType[hidden], .action-status:empty { display: none; }
    .action-status { color: var(--text-soft); font-size: 12px; }
    .name-result.result-item, .match-row.result-item, .file-heading[role="button"] { cursor: pointer; }
    .file-heading[role="button"]:focus-visible { outline: 0; box-shadow: var(--focus); }

    .results-shell {
      margin-top: 20px;
    }

    .state-card {
      display: grid;
      justify-items: center;
      width: min(520px, 100%);
      margin: 58px auto 0;
      padding: 34px 28px;
      border: 1px solid transparent;
      border-radius: 14px;
      color: var(--text-soft);
      text-align: center;
    }

    .state-symbol {
      display: grid;
      width: 34px;
      height: 34px;
      margin-bottom: 15px;
      place-items: center;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: var(--canvas-raised);
      color: var(--text-faint);
      font-family: "SFMono-Regular", Consolas, monospace;
      font-size: 13px;
      font-weight: 650;
    }

    .state-title {
      margin: 0;
      color: var(--text);
      font-size: 14px;
      font-weight: 650;
      letter-spacing: -0.005em;
    }

    .state-detail {
      max-width: 390px;
      margin: 7px 0 0;
      color: var(--text-soft);
      font-size: 13px;
      line-height: 1.55;
    }

    .state-card.empty {
      border-color: var(--line);
      background: var(--canvas-raised);
    }

    .state-card.error {
      border-color: color-mix(in srgb, var(--danger) 28%, var(--line));
      background: var(--danger-soft);
    }

    .state-card.error .state-symbol,
    .state-card.error .state-title {
      color: var(--danger);
    }

    .state-card.notice {
      border-color: color-mix(in srgb, var(--warning) 28%, var(--line));
      background: var(--warning-soft);
    }

    .state-card.notice .state-symbol,
    .state-card.notice .state-title {
      color: var(--warning);
    }

    .loading-card {
      width: min(520px, 100%);
      margin: 58px auto 0;
      color: var(--text-soft);
      text-align: center;
    }

    .loader {
      width: 22px;
      height: 22px;
      margin: 0 auto 15px;
      border: 2px solid var(--line);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: spin 700ms linear infinite;
    }

    .loading-text {
      min-height: 20px;
      font-size: 13px;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
      }
    }

    .results-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 34px;
      margin-bottom: 8px;
      padding: 0 4px;
      color: var(--text-soft);
      font-size: 12px;
    }

    .results-count {
      font-variant-numeric: tabular-nums;
    }

    .navigation-hint {
      color: var(--text-faint);
    }

    .truncated {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 11px;
      margin-bottom: 12px;
      padding: 11px 13px;
      border: 1px solid color-mix(in srgb, var(--warning) 30%, var(--line));
      border-radius: 10px;
      background: var(--warning-soft);
      color: var(--text-soft);
      font-size: 12px;
      line-height: 1.45;
    }

    .truncated-icon {
      color: var(--warning);
      font-family: "SFMono-Regular", Consolas, monospace;
      font-weight: 700;
    }

    .truncated strong {
      color: var(--text);
      font-weight: 650;
    }

    .file-group {
      overflow: hidden;
      margin-bottom: 10px;
      border: 1px solid var(--line);
      border-radius: 11px;
      background: var(--canvas-raised);
    }

    .file-heading {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 10px;
      min-height: 39px;
      padding: 0 13px;
      border-bottom: 1px solid var(--line);
      background: color-mix(in srgb, var(--surface) 58%, var(--canvas-raised));
    }

    .file-glyph {
      position: relative;
      width: 12px;
      height: 15px;
      border: 1px solid var(--text-faint);
      border-radius: 2px;
      opacity: 0.75;
    }

    .file-glyph::after {
      position: absolute;
      top: 3px;
      left: 2px;
      width: 6px;
      height: 1px;
      background: var(--text-faint);
      box-shadow: 0 3px 0 var(--text-faint), 0 6px 0 var(--text-faint);
      content: "";
      opacity: 0.7;
    }

    .file-path {
      overflow: hidden;
      color: var(--text);
      font-family: "SFMono-Regular", Consolas, monospace;
      font-size: 11.5px;
      font-weight: 600;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .file-count {
      padding: 2px 7px;
      border: 1px solid var(--line);
      border-radius: 999px;
      color: var(--text-faint);
      font-size: 10px;
      font-variant-numeric: tabular-nums;
    }

    .match-row {
      position: relative;
      display: grid;
      grid-template-columns: 54px minmax(0, 1fr) auto;
      align-items: start;
      min-height: 39px;
      outline: 0;
      cursor: default;
    }

    .match-row + .match-row {
      border-top: 1px solid color-mix(in srgb, var(--line) 68%, transparent);
    }

    .match-row:hover,
    .match-row:focus,
    .match-row[aria-selected="true"] {
      background: var(--surface-hover);
    }

    .match-row:focus::before,
    .match-row[aria-selected="true"]::before {
      position: absolute;
      top: 7px;
      bottom: 7px;
      left: 0;
      width: 2px;
      border-radius: 0 2px 2px 0;
      background: var(--accent);
      content: "";
    }

    .line-number {
      padding: 11px 12px 9px 8px;
      color: var(--text-faint);
      font-family: "SFMono-Regular", Consolas, monospace;
      font-size: 10.5px;
      line-height: 1.55;
      text-align: right;
      font-variant-numeric: tabular-nums;
      user-select: none;
    }

    .line-text {
      min-width: 0;
      margin: 0;
      padding: 10px 14px 9px 0;
      overflow-wrap: anywhere;
      color: var(--text-soft);
      font-family: "SFMono-Regular", Consolas, monospace;
      font-size: 11.5px;
      line-height: 1.55;
      white-space: pre-wrap;
    }

    mark {
      margin: 0 -1px;
      padding: 1px;
      border-radius: 2px;
      background: var(--mark);
      color: var(--mark-ink);
    }

    .clipped {
      align-self: center;
      margin-right: 10px;
      padding: 2px 6px;
      border: 1px solid var(--line);
      border-radius: 5px;
      color: var(--text-faint);
      font-size: 9px;
      font-weight: 650;
      letter-spacing: 0.03em;
      white-space: nowrap;
    }

    .name-list {
      display: grid;
      gap: 7px;
    }

    .name-result {
      position: relative;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: 11px;
      min-height: 44px;
      padding: 0 14px;
      border: 1px solid var(--line);
      border-radius: 10px;
      outline: 0;
      background: var(--canvas-raised);
      cursor: default;
    }

    .name-result:hover,
    .name-result:focus,
    .name-result[aria-selected="true"] {
      border-color: var(--line-strong);
      background: var(--surface-hover);
    }

    .name-result:focus::before,
    .name-result[aria-selected="true"]::before {
      position: absolute;
      top: 8px;
      bottom: 8px;
      left: 0;
      width: 2px;
      border-radius: 0 2px 2px 0;
      background: var(--accent);
      content: "";
    }

    .name-result .file-path {
      font-weight: 500;
    }

    @media (max-width: 680px) {
      .app {
        width: min(100% - 24px, 1040px);
        padding-top: 16px;
      }

      .command-wrap {
        margin-top: clamp(74px, 16vh, 130px);
      }

      body.has-query .command-wrap {
        margin-top: 18px;
      }

      .query-row {
        min-height: 64px;
        padding: 0 16px;
      }

      .shortcut {
        display: none;
      }

      .filters {
        grid-template-columns: 1fr 1fr;
      }

      .mode-switch {
        grid-column: 1 / -1;
      }

      .results-shell {
        margin-top: 14px;
      }

      .navigation-hint {
        display: none;
      }

      .match-row {
        grid-template-columns: 42px minmax(0, 1fr);
      }

      .line-number {
        padding-right: 9px;
      }

      .clipped {
        grid-column: 2;
        justify-self: start;
        margin: 0 0 8px;
      }
    }
  </style>
</head>
<body class="has-query">
  <main class="app">
    <header class="topbar">
      <div class="identity">
        <span class="identity-mark" aria-hidden="true"></span>
        <span>Search</span>
      </div>
      <div class="access" id="access" data-state="ready">
        <span class="access-dot" aria-hidden="true"></span>
        <span id="accessText">Ready</span>
      </div>
    </header>

    <section class="command-wrap" aria-label="Search controls">
      <div class="command">
        <div class="query-row">
          <span class="search-icon" aria-hidden="true"></span>
          <input id="query" type="text" placeholder="Search this folder" autocomplete="off" spellcheck="false" autofocus="" aria-label="Search query">
          <span class="shortcut" aria-hidden="true">⌘ K</span>
        </div>

        <div class="filters">
          <div class="mode-switch" role="radiogroup" aria-label="Search mode">
            <label class="mode-option">
              <input type="radio" name="mode" value="contents" checked="">
              <span>Contents</span>
            </label>
            <label class="mode-option">
              <input type="radio" name="mode" value="name">
              <span>Filenames</span>
            </label>
          </div>

          <div class="field">
            <label class="field-label" for="fileKind">File type</label>
            <select id="fileKind">
              <option value="all">All files</option>
              <option value="images">Images</option>
              <option value="video">Video</option>
              <option value="audio">Audio</option>
              <option value="documents">Documents</option>
              <option value="data">Spreadsheets &amp; data</option>
              <option value="presentations">Presentations</option>
              <option value="code">Code</option>
              <option value="fonts">Fonts</option>
              <option value="archives">Archives</option>
              <option value="custom">Custom extension</option>
            </select>
            <input id="fileType" type="text" placeholder="e.g. svg or ts" autocomplete="off" spellcheck="false" aria-label="Custom file extension" hidden="">
          </div>

          <label class="field">
            <span class="field-label">Shortcuts</span>
            <select id="scope"><option value="">Custom folder</option><option value="github">GitHub</option><option value="hyperclay">Hyperclay</option><option value="plans">Plans</option><option value="documents">Documents</option><option value="downloads">Downloads</option><option value="dropbox">Dropbox Current</option><option value="polsia">Polsia research</option></select>
          </label>

          <div class="field folder-field">
            <label class="field-label" for="root">Folder</label>
            <div class="folder-controls">
              <input id="root" type="text" placeholder="/path/to/folder or ~/folder" autocomplete="off" spellcheck="false">
              <button id="chooseFolder" type="button">Choose Folder…</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <p class="action-status" id="actionStatus" role="status"></p>

    <section class="results-shell" id="results" clay="no-snapshot" aria-live="polite" aria-busy="false"></section>
  </main>

  <script src="clay/clay.js?plugins=wire,sync"></script>
  <script>
    (() => {
      // Long enough that typing a word does not fire a search per keystroke on a
      // scope the size of GitHub, short enough to still feel live on a small one.
      // Enter bypasses it entirely.
      const SEARCH_DEBOUNCE_MS = 1000;

      const queryInput = document.querySelector("#query");
      const fileTypeInput = document.querySelector("#fileType");
      const fileKindSelect = document.querySelector("#fileKind");
      const scopeSelect = document.querySelector("#scope");
      const rootInput = document.querySelector("#root");
      const chooseFolderButton = document.querySelector("#chooseFolder");
      const actionStatus = document.querySelector("#actionStatus");
      const modeInputs = [...document.querySelectorAll('input[name="mode"]')];
      const results = document.querySelector("#results");
      const access = document.querySelector("#access");
      const accessText = document.querySelector("#accessText");

      const state = {
        helper: "checking",
        activeCall: null,
        debounceTimer: null,
        scopes: [],
        generation: 0,
        resultItems: [],
        activeIndex: -1,
        browseAll: false,
        picking: false
      };

      const copy = {
        unknown_scope: "Pick a location from Shortcuts or enter a folder path.",
        scope_unavailable: "That folder is not on this Mac.",
        folder_picker_failed: "The folder picker could not open. Type the path instead.",
        reveal_failed: "Finder could not reveal that file.",
        tool_unavailable: "Install ripgrep and fd, then search again.",
        invalid_request: "Check the query and filters.",
        unsupported_operation: "The search helper does not support this request.",
        helper_not_granted: "Search access is not available for this file.",
        helper_busy: "Eight searches are already running. Pause for a moment, then type again.",
        helper_cancelled: "Search was cancelled.",
        helper_start_failed: "The search helper could not start.",
        helper_result_too_large: "Narrow the place or file type, then search again.",
        helper_interpreter_missing: "The search helper needs a local interpreter that is not installed."
      };

      function element(tag, className, text) {
        const node = document.createElement(tag);
        if (className) node.className = className;
        if (text !== undefined) node.textContent = text;
        return node;
      }

      function setAccess(nextState, text) {
        access.dataset.state = nextState;
        accessText.textContent = text;
      }

      function setControlsEnabled(enabled) {
        queryInput.disabled = !enabled;
        fileTypeInput.disabled = !enabled;
        fileKindSelect.disabled = !enabled;
        scopeSelect.disabled = !enabled;
        rootInput.disabled = !enabled;
        chooseFolderButton.disabled = !enabled || state.picking;
        modeInputs.forEach(input => {
          input.disabled = !enabled;
        });
      }

      function resetResultNavigation() {
        state.resultItems = [];
        state.activeIndex = -1;
      }

      function stateCard(kind, symbol, title, detail) {
        resetResultNavigation();
        results.replaceChildren();
        results.setAttribute("aria-busy", "false");
        const card = element("div", `state-card ${kind}`.trim());
        card.append(
          element("div", "state-symbol", symbol),
          element("p", "state-title", title),
          element("p", "state-detail", detail)
        );
        card.firstElementChild.setAttribute("aria-hidden", "true");
        results.append(card);
      }

      function renderIdle() {
        stateCard("idle", "/", "Search a phrase or choose a file type", "Select any folder, then search its filenames or text contents.");
      }

      function renderEmpty() {
        stateCard("empty", "0", "No matches", "Try a broader phrase, another file type, or a different place.");
      }

      function renderUnavailable(kind) {
        if (kind === "denied") {
          stateCard("error", "×", "Search access was declined", "This file cannot use the search helper.");
          return;
        }
        if (kind === "old_host") {
          stateCard("notice", "!", "HTML Clay needs an update", "Update HTML Clay, then close and reopen this file.");
          return;
        }
        // Reloading the tab is the one thing that cannot fix this: a reload takes
        // the same route that failed to attach the helper. Opening the document
        // itself is a different path, and it is the one that attaches it.
        stateCard("notice", "!", "Search is not available", "Open this file from Finder to set it up, or allow Search in HTML Clay's Programs menu. Reloading this tab will not help.");
      }

      function renderLoading(status) {
        resetResultNavigation();
        results.replaceChildren();
        results.setAttribute("aria-busy", "true");
        const card = element("div", "loading-card");
        const loader = element("div", "loader");
        loader.setAttribute("aria-hidden", "true");
        card.append(loader, element("div", "loading-text", status || "Searching"));
        results.append(card);
      }

      function renderError(outcome) {
        const message = typeof outcome?.error === "string" && outcome.error.trim()
          ? outcome.error
          : "The search could not be completed.";
        const guidance = copy[outcome?.errorCode] || "Change the search and try again.";

        resetResultNavigation();
        results.replaceChildren();
        results.setAttribute("aria-busy", "false");
        const card = element("div", "state-card error");
        const symbol = element("div", "state-symbol", "×");
        symbol.setAttribute("aria-hidden", "true");
        const title = element("p", "state-title", "Search stopped");
        const detail = element("p", "state-detail");
        detail.append(document.createTextNode(message), document.createElement("br"), document.createTextNode(guidance));
        card.append(symbol, title, detail);
        results.append(card);
      }

      function selectedMode() {
        return modeInputs.find(input => input.checked)?.value || "contents";
      }

      function hasFileFilter() {
        return fileKindSelect.value === "custom"
          ? Boolean(fileTypeInput.value.trim())
          : fileKindSelect.value !== "all";
      }

      function hasSearch() {
        return Boolean(queryInput.value.trim()) || hasFileFilter() || state.browseAll;
      }

      function selectMode(mode) {
        modeInputs.forEach(input => { input.checked = input.value === mode; });
      }

      function syncShortcut() {
        scopeSelect.value = state.scopes.find(scope => scope.path === rootInput.value)?.key || "";
      }

      function applyLaunchFolder() {
        const root = new URLSearchParams(window.location.hash.slice(1)).get("root");
        if (!root) return false;
        rootInput.value = root;
        state.browseAll = true;
        selectMode("name");
        syncShortcut();
        return true;
      }

      async function helperAction(payload) {
        const outcome = await clay.wire.send(payload, { helper: "search" }).done;
        if (outcome?.state !== "done") throw new Error(outcome?.error || "The action could not be completed.");
        return outcome.result;
      }

      async function pickFolder() {
        if (state.picking || state.helper !== "ready") return;
        state.picking = true;
        chooseFolderButton.disabled = true;
        actionStatus.textContent = "";
        try {
          const result = await helperAction({ op: "chooseFolder" });
          if (result?.cancelled) return;
          if (typeof result?.root !== "string" || !result.root) throw new Error("No folder was selected.");
          rootInput.value = result.root;
          syncShortcut();
          scheduleSearch();
        } catch (error) {
          actionStatus.textContent = error.message;
        } finally {
          state.picking = false;
          chooseFolderButton.disabled = state.helper !== "ready";
        }
      }

      function attachReveal(node, path, root) {
        node.title = "Reveal in Finder";
        const reveal = async () => {
          actionStatus.textContent = "";
          try {
            await helperAction({ op: "reveal", root, path });
            actionStatus.textContent = "Revealed in Finder.";
          } catch (error) {
            actionStatus.textContent = error.message;
          }
        };
        node.addEventListener("click", reveal);
        node.addEventListener("keydown", event => {
          if (event.key !== "Enter" && event.key !== " ") return;
          event.preventDefault();
          reveal();
        });
      }

      function appendHighlighted(container, value, query) {
        const text = typeof value === "string" ? value : String(value ?? "");
        if (!query) {
          container.append(document.createTextNode(text));
          return;
        }

        let cursor = 0;
        let matchIndex = text.indexOf(query, cursor);
        while (matchIndex !== -1) {
          container.append(document.createTextNode(text.slice(cursor, matchIndex)));
          const mark = document.createElement("mark");
          mark.textContent = text.slice(matchIndex, matchIndex + query.length);
          container.append(mark);
          cursor = matchIndex + query.length;
          matchIndex = text.indexOf(query, cursor);
        }
        container.append(document.createTextNode(text.slice(cursor)));
      }

      function registerResultItem(node, path, root) {
        node.classList.add("result-item");
        node.tabIndex = -1;
        node.setAttribute("role", "option");
        node.setAttribute("aria-selected", "false");
        node.addEventListener("focus", () => {
          setActiveResult(state.resultItems.indexOf(node), false);
        });
        node.addEventListener("mousedown", () => node.focus());
        state.resultItems.push(node);
        attachReveal(node, path, root);
      }

      function setActiveResult(index, moveFocus = true) {
        if (!state.resultItems.length) return;
        const normalized = (index + state.resultItems.length) % state.resultItems.length;
        state.resultItems.forEach((item, itemIndex) => {
          item.setAttribute("aria-selected", itemIndex === normalized ? "true" : "false");
        });
        state.activeIndex = normalized;
        if (moveFocus) {
          state.resultItems[normalized].focus({ preventScroll: true });
          state.resultItems[normalized].scrollIntoView({ block: "nearest", behavior: "smooth" });
        }
      }

      function resultsMeta(matchCount, fileCount, mode) {
        const meta = element("div", "results-meta");
        const count = element("div", "results-count");
        if (mode === "name") {
          count.textContent = `${matchCount} ${matchCount === 1 ? "file" : "files"}`;
        } else {
          const matchWord = matchCount === 1 ? "match" : "matches";
          const fileWord = fileCount === 1 ? "file" : "files";
          count.textContent = `${matchCount} ${matchWord} in ${fileCount} ${fileWord}`;
        }
        meta.append(count, element("div", "navigation-hint", "↑ ↓ to move · Enter to reveal in Finder"));
        return meta;
      }

      function truncatedNotice() {
        const notice = element("div", "truncated");
        const icon = element("div", "truncated-icon", "!");
        icon.setAttribute("aria-hidden", "true");
        const text = element("div");
        const strong = element("strong", "", "More matches exist. ");
        text.append(strong, document.createTextNode("These results reached the helper limit. Narrow the place or file type to see a smaller set."));
        notice.append(icon, text);
        return notice;
      }

      function renderNameResults(matches, truncated, query, root) {
        resetResultNavigation();
        results.replaceChildren();
        results.setAttribute("aria-busy", "false");
        results.append(resultsMeta(matches.length, matches.length, "name"));
        if (truncated) results.append(truncatedNotice());

        const list = element("div", "name-list");
        list.setAttribute("role", "listbox");
        matches.forEach(match => {
          const row = element("div", "name-result");
          const glyph = element("span", "file-glyph");
          glyph.setAttribute("aria-hidden", "true");
          const path = element("span", "file-path");
          appendHighlighted(path, match?.path, query);
          row.append(glyph, path);
          registerResultItem(row, match?.path, root);
          list.append(row);
        });
        results.append(list);
      }

      function renderContentResults(matches, truncated, query, root) {
        resetResultNavigation();
        results.replaceChildren();
        results.setAttribute("aria-busy", "false");

        const groups = new Map();
        matches.forEach(match => {
          const path = typeof match?.path === "string" ? match.path : String(match?.path ?? "");
          if (!groups.has(path)) groups.set(path, []);
          groups.get(path).push(match);
        });

        results.append(resultsMeta(matches.length, groups.size, "contents"));
        if (truncated) results.append(truncatedNotice());

        const list = element("div");
        list.setAttribute("role", "listbox");
        groups.forEach((fileMatches, pathValue) => {
          const group = element("section", "file-group");
          group.setAttribute("role", "group");
          const heading = element("div", "file-heading");
          heading.setAttribute("role", "button");
          heading.tabIndex = 0;
          const glyph = element("span", "file-glyph");
          glyph.setAttribute("aria-hidden", "true");
          const path = element("div", "file-path", pathValue);
          const count = element("div", "file-count", String(fileMatches.length));
          heading.append(glyph, path, count);
          attachReveal(heading, pathValue, root);
          group.append(heading);

          fileMatches.forEach(match => {
            const row = element("div", "match-row");
            const line = element("div", "line-number", match?.line ?? "");
            const code = element("pre", "line-text");
            appendHighlighted(code, match?.text, query);
            row.append(line, code);
            if (match?.textTruncated) row.append(element("span", "clipped", "Line clipped"));
            registerResultItem(row, pathValue, root);
            group.append(row);
          });
          list.append(group);
        });
        results.append(list);
      }

      function renderResults(result, query, mode, root) {
        const matches = Array.isArray(result?.matches) ? result.matches : [];
        if (!matches.length) {
          renderEmpty();
          return;
        }
        if (mode === "name") {
          renderNameResults(matches, Boolean(result?.truncated), query, root);
        } else {
          renderContentResults(matches, Boolean(result?.truncated), query, root);
        }
      }

      function cancelActiveCall() {
        if (!state.activeCall) return;
        try {
          state.activeCall.cancel();
        } catch {}
        state.activeCall = null;
      }

      async function startSearch(generation) {
        if (generation !== state.generation || state.helper !== "ready") return;
        if (!hasSearch()) return;
        const query = queryInput.value.trim() ? queryInput.value : "";
        if (!query) selectMode("name");
        const mode = selectedMode();
        const root = rootInput.value;
        if (!root.trim()) {
          renderError({ error: "Choose a folder or enter its path.", errorCode: "scope_unavailable" });
          return;
        }
        const payload = { op: "search", root, query, mode };
        if (fileKindSelect.value === "custom") {
          const fileType = fileTypeInput.value.trim();
          if (fileType) payload.fileType = fileType;
        } else if (fileKindSelect.value !== "all") {
          payload.fileKind = fileKindSelect.value;
        }

        renderLoading("Searching");
        let issuedCall;
        try {
          issuedCall = clay.wire.send(payload, {
            helper: "search",
            onStatus: status => {
              if (generation !== state.generation || state.activeCall !== issuedCall) return;
              renderLoading(typeof status === "string" && status.trim() ? status : "Searching");
            }
          });
          state.activeCall = issuedCall;
        } catch (error) {
          if (generation !== state.generation) return;
          renderError({ error: error instanceof Error ? error.message : "The search could not start.", errorCode: "helper_start_failed" });
          return;
        }

        let outcome;
        try {
          outcome = await issuedCall.done;
        } catch (error) {
          outcome = { state: "error", error: error instanceof Error ? error.message : "The search could not be completed." };
        }

        if (generation !== state.generation || state.activeCall !== issuedCall) return;
        state.activeCall = null;
        if (outcome?.state === "done") {
          renderResults(outcome.result, query, mode, outcome.result?.root || root);
        } else {
          renderError(outcome);
        }
      }

      function scheduleSearch() {
        window.clearTimeout(state.debounceTimer);
        cancelActiveCall();
        state.generation += 1;
        const generation = state.generation;
        const active = hasSearch();
        document.body.classList.toggle("has-query", active);

        if (!active) {
          if (state.helper === "ready") renderIdle();
          return;
        }
        if (state.helper !== "ready") return;

        renderLoading("Waiting for input");
        state.debounceTimer = window.setTimeout(() => startSearch(generation), SEARCH_DEBOUNCE_MS);
      }

      async function loadScopes() {
        try {
          const result = await helperAction({ op: "scopes" });
          if (!Array.isArray(result?.scopes) || !result.scopes.length || typeof result.defaultRoot !== "string") {
            throw new Error("The search helper needs to be updated.");
          }
          state.scopes = result.scopes;
          scopeSelect.replaceChildren();
          const custom = document.createElement("option");
          custom.value = "";
          custom.textContent = "Custom folder";
          scopeSelect.append(custom);
          for (const scope of state.scopes) {
            const option = document.createElement("option");
            option.value = scope.key;
            option.textContent = scope.available ? scope.label : scope.label + " (not found)";
            option.disabled = !scope.available;
            scopeSelect.append(option);
          }
          rootInput.value = result.defaultRoot;
          state.browseAll = false;
          applyLaunchFolder();
          syncShortcut();
          return true;
        } catch (error) {
          setAccess("error", "Folder list unavailable");
          renderError({ error: error.message, errorCode: "scope_unavailable" });
          return false;
        }
      }

      async function discoverHelper() {
        try {
          // clay.wire is attached by the plugin, which loads after the loader.
          // Reading it before clay.ready resolves finds nothing and lands in the
          // catch below, which reports an old host permanently and never retries.
          if (window.clay?.ready) await window.clay.ready;
          if (!window.clay?.wire?.helpers) throw new Error("wire_unavailable");
          const helpers = await clay.wire.helpers();
          const helper = Array.isArray(helpers) ? helpers.find(item => item?.name === "search") : null;
          state.helper = helper?.state || "unavailable";

          if (state.helper === "ready") {
            setAccess("ready", "Ready");
            if (!await loadScopes()) { setControlsEnabled(false); return; }
            setControlsEnabled(true);
            scheduleSearch();
            queryInput.focus();
            return;
          }

          setControlsEnabled(false);
          if (state.helper === "denied") {
            setAccess("denied", "Access declined");
            renderUnavailable("denied");
          } else {
            setAccess("unavailable", "Setup needed");
            renderUnavailable("unavailable");
          }
        } catch {
          state.helper = "old_host";
          setControlsEnabled(false);
          setAccess("error", "Update needed");
          renderUnavailable("old_host");
        }
      }

      queryInput.addEventListener("input", scheduleSearch);
      fileTypeInput.addEventListener("input", scheduleSearch);
      modeInputs.forEach(input => input.addEventListener("change", scheduleSearch));

      scopeSelect.addEventListener("change", () => {
        const scope = state.scopes.find(item => item.key === scopeSelect.value);
        if (!scope?.available) return;
        rootInput.value = scope.path;
        scheduleSearch();
      });

      rootInput.addEventListener("input", () => {
        syncShortcut();
        scheduleSearch();
      });

      chooseFolderButton.addEventListener("click", pickFolder);

      fileKindSelect.addEventListener("change", () => {
        fileTypeInput.hidden = fileKindSelect.value !== "custom";
        scheduleSearch();
      });

      function searchImmediately(event) {
        if (event.key !== "Enter" || event.metaKey || event.ctrlKey || event.altKey) return;
        // Enter means search now. The debounce exists to keep a large scope from
        // searching on every keystroke, and waiting it out after an explicit
        // Enter would just look like the key did nothing.
        event.preventDefault();
        window.clearTimeout(state.debounceTimer);
        if (state.helper !== "ready" || !hasSearch()) return;
        cancelActiveCall();
        state.generation += 1;
        startSearch(state.generation);
      }

      queryInput.addEventListener("keydown", searchImmediately);
      rootInput.addEventListener("keydown", searchImmediately);
      fileTypeInput.addEventListener("keydown", searchImmediately);

      document.addEventListener("keydown", event => {
        const resultItem = event.target.closest?.(".result-item");
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
          event.preventDefault();
          queryInput.focus();
          queryInput.select();
          return;
        }
        if (event.key === "/" && !event.metaKey && !event.ctrlKey && !event.altKey && !event.target.matches("input, textarea")) {
          event.preventDefault();
          queryInput.focus();
          return;
        }
        if (event.key === "Escape" && resultItem) {
          queryInput.focus();
          return;
        }
        if ((event.target !== queryInput && !resultItem) || !state.resultItems.length) return;
        if (event.key === "ArrowDown") {
          event.preventDefault();
          setActiveResult(state.activeIndex + 1);
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          setActiveResult(state.activeIndex < 0 ? state.resultItems.length - 1 : state.activeIndex - 1);
        }
      });

      window.addEventListener("hashchange", () => {
        if (state.helper === "ready" && applyLaunchFolder()) scheduleSearch();
      });

      setControlsEnabled(false);
      discoverHelper();
    })();
  </script>


</body></html>